---
import type { CollectionEntry } from 'astro:content';

import { withBase } from '../lib/paths';

interface Props {
  area: CollectionEntry<'expertise'>;
}

const { area } = Astro.props;
const { preview, title } = area.data;
---

<article class:list={['expertise-preview', area.id]}>
  <div class="preview-art">
    <img
      src={withBase(preview.image.src)}
      width={preview.image.width}
      height={preview.image.height}
      alt={preview.image.alt}
      loading="lazy"
      decoding="async"
    />
    {preview.texture && (
      <img
        class="texture"
        src={withBase(preview.texture.src)}
        width={preview.texture.width}
        height={preview.texture.height}
        alt={preview.texture.alt}
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      />
    )}
  </div>
  <div class="copy-stack">
    <p class="label">{preview.label}</p>
    <h3>{title}</h3>
    <p class="preview-heading heading">{preview.heading}</p>
    {preview.descriptions.length > 1 ? (
      <ul class="muted">
        {preview.descriptions.map((description) => (
          <li>{description}</li>
        ))}
      </ul>
    ) : (
      <p class="muted">{preview.descriptions[0]}</p>
    )}
    <a class="text-link" href={withBase(`${area.id}/`)}>
      {preview.linkLabel}
    </a>
  </div>
</article>

<style>
  .preview-art {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    aspect-ratio: 880 / 563.444;
    margin-bottom: var(--space-copy);
    border-radius: var(--radius);
    background: white;
  }

  .preview-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .merch-and-brand-experience .preview-art img {
    position: absolute;
    width: 154.3%;
    max-width: none;
    height: auto;
    left: -34.42%;
    top: -61.35%;
  }

  .paid-and-organic-content .preview-art {
    background: var(--ink);
  }

  .paid-and-organic-content .preview-art img {
    position: absolute;
    width: 122.61%;
    max-width: none;
    height: auto;
    left: -11.25%;
    top: -31.83%;
  }

  .ai-assisted-imagery .preview-art > img:first-child {
    position: absolute;
    width: 133.89%;
    max-width: none;
    height: auto;
    left: -16.94%;
    top: -19.52%;
  }

  .preview-art .texture {
    position: absolute;
    inset: 0;
    opacity: 0.4;
    mix-blend-mode: overlay;
  }

  h3 {
    font-size: var(--text-heading);
  }

  .preview-heading {
    font-size: var(--text-subheading);
  }

  ul {
    padding-left: var(--space-layout);
  }

  .text-link {
    display: block;
  }
</style>
