---
interface Props {
  items: { heading: string; description: string; number?: string }[];
  numbered?: boolean;
  stacked?: boolean;
}

const { items, numbered = false, stacked = false } = Astro.props;
---

<div class:list={['content-rows', { numbered, stacked }]}>
  {items.map((item) => (
    <div class="content-row">
      {numbered && <p class="row-number heading">{item.number}</p>}
      <h3>{item.heading}</h3>
      <p>{item.description}</p>
    </div>
  ))}
</div>

<style>
  .content-row {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: var(--space-medium);
    padding-block: var(--space-copy);
    border-top: 1px solid var(--line);
  }

  .numbered .content-row {
    grid-template-columns: 3.5rem minmax(0, 1fr);
    column-gap: var(--space-layout);
    row-gap: var(--space-tight);
    padding-block: var(--space-layout);
  }

  .stacked .content-row {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-tight);
    padding-block: var(--space-layout);
  }

  .content-row:last-child {
    padding-bottom: 0;
  }

  .numbered h3 {
    font-size: var(--text-row-heading);
  }

  .numbered .content-row > p:last-child {
    grid-column: 2;
  }

  .row-number {
    grid-row: span 2;
    color: var(--accent);
    font-size: var(--text-number);
  }

  @media (max-width: 700px) {
    .content-row,
    .numbered .content-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-layout);
    }

    .numbered .content-row > p:last-child {
      grid-column: 1;
    }

    .row-number {
      grid-row: auto;
    }
  }
</style>
