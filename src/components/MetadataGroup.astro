---
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'expertise'>['data']['metadata'];
}

const { items } = Astro.props;
---

<dl class="metadata-group">
  {items.map((item) => (
    <div class="metadata-item">
      <dt class="label">{item.label}</dt>
      <dd>
        {item.headings.map((heading) => (
          <p class="metadata-heading heading">{heading}</p>
        ))}
        {item.description && (
          <p class="metadata-description muted">{item.description}</p>
        )}
      </dd>
    </div>
  ))}
</dl>

<style>
  .metadata-group {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-medium);
    margin-top: var(--space-medium);
    padding-block: var(--space-layout);
    border-block: 1px solid var(--line);
  }

  .metadata-heading {
    margin-top: var(--space-tight);
    font-size: var(--text-subheading);
    line-height: var(--leading-metadata);
  }

  .metadata-description {
    margin-top: var(--space-tight);
    font: 400 var(--text-ui) / var(--leading-heading) var(--font-heading);
  }

  @media (max-width: 700px) {
    .metadata-group {
      grid-template-columns: 1fr;
      gap: var(--space-layout);
    }
  }
</style>
