---
import type { getSite } from '../lib/content';
import { withBase } from '../lib/paths';

interface Props {
  site: Awaited<ReturnType<typeof getSite>>;
}

const { site } = Astro.props;
---

<header class="site-header">
  <a class="wordmark" href={withBase('#top')}>
    {site.name}
  </a>
  <nav aria-label="Main navigation">
    {site.navigation.map((link) => (
      <a href={withBase(`#${link.section}`)}>{link.label}</a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-medium);
    min-height: var(--header-height);
    padding: var(--space-medium) clamp(2.75rem, 5.625vw, 4.5rem);
    background: var(--paper);
  }

  .wordmark {
    font: 500 var(--text-subheading) / var(--leading-heading)
      var(--font-heading);
    white-space: nowrap;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-small) var(--space-medium);
    font-size: var(--text-ui);
  }

  @media (max-width: 700px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-small);
      padding: var(--space-layout) var(--gutter);
    }

    nav {
      gap: 0.5rem var(--space-inline);
      font-size: var(--text-label);
    }

    nav a {
      padding-block: 0.3rem;
    }
  }
</style>
