---
import type { getSite } from '../lib/content';
import { withBase } from '../lib/paths';

interface Props {
  site: Awaited<ReturnType<typeof getSite>>;
}

const { site } = Astro.props;
---

<header class="site-header">
  <a class="wordmark" href={withBase('#top')}>
    {site.name}
  </a>
  <nav aria-label="Main navigation">
    {site.navigation.map((link) => (
      <a href={withBase(`#${link.section}`)}>{link.label}</a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: var(--header-height);
    padding: 2rem clamp(2.75rem, 5.625vw, 4.5rem);
    background: var(--paper);
  }

  .wordmark {
    font: 500 1.25rem / 1.2 var(--font-heading);
    white-space: nowrap;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    font-size: 1rem;
  }

  @media (max-width: 700px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem var(--gutter);
    }

    nav {
      gap: 0.5rem 1.25rem;
      font-size: 0.875rem;
    }

    nav a {
      padding-block: 0.3rem;
    }
  }
</style>
