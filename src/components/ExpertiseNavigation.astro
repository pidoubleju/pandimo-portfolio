---
import { getExpertiseAreas, getSite } from '../lib/content';
import { withBase } from '../lib/paths';

interface Props {
  id: string;
}

const { id } = Astro.props;
const site = await getSite();
const areas = await getExpertiseAreas();
const index = areas.findIndex((area) => area.id === id);
const current = areas[index];
if (!current) throw new Error(`Unknown expertise navigation: ${id}`);
const previous = areas[index - 1];
const next = areas[index + 1];
---

<footer class="expertise-navigation">
  <div class="copy-stack">
    <p class="label">{current.data.nextLabel ?? site.overviewLabel}</p>
    <a
      class="next-link heading"
      href={next ? withBase(`${next.id}/`) : withBase('#work')}
    >
      {current.data.nextLinkLabel ?? site.overviewLinkLabel}
    </a>
    {!next && (
      <a class="text-link contact-link" href={`mailto:${site.email}`}>
        {site.contactLinkLabel}
      </a>
    )}
  </div>
  <div class="page-ends">
    <a href={previous ? withBase(`${previous.id}/`) : withBase('#work')}>
      {site.previousLabel}
    </a>
    <a href="#top">{site.topLabel}</a>
  </div>
</footer>

<style>
  .expertise-navigation {
    margin-top: var(--space-large);
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }

  .next-link {
    display: block;
    width: fit-content;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    text-decoration: none;
  }

  .next-link:hover {
    text-decoration: underline;
  }

  .contact-link {
    display: block;
  }

  .page-ends {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
    font-size: 0.75rem;
  }

  .page-ends a:first-child {
    color: var(--muted);
  }
</style>
