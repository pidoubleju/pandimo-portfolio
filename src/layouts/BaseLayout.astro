---
import { site } from '../data/site';
import { withBase } from '../lib/paths';

import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f2" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header container">
      <a class="wordmark" href={withBase()} aria-label={`${site.name}, home`}>
        {site.name}
        <span aria-hidden="true">✳</span>
      </a>
      <nav aria-label="Main navigation">
        <a href={withBase('#work')}>Work</a>
        <a href={withBase('#about')}>About</a>
        <a class="nav-contact" href={withBase('#contact')}>
          Let’s talk <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <p>
        © {new Date().getFullYear()} {site.name}
      </p>
      <p>Made with care. Kept simple.</p>
      <a href={withBase()}>
        Back to home <span aria-hidden="true">↗</span>
      </a>
    </footer>
  </body>
</html>
